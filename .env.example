# Production site URL (used for canonical/OG URLs in client-side SEO)
VITE_SITE_URL=https://www.wellpredict.co.uk

# Contact form endpoint (defaults to /api/contact on Vercel)
VITE_CONTACT_API_URL=/api/contact

# Server-only (Vercel / .env.local): Resend API key for /api/contact
# RESEND_API_KEY=
# Optional From address (must be on a Resend-verified domain)
# For local testing without a verified domain, use Resend's onboarding sender:
# CONTACT_FROM_EMAIL=WellPredict Website <onboarding@resend.dev>
# CONTACT_FROM_EMAIL=WellPredict Website <hello@wellpredict.co.uk>
